# Mars Explorer — environment template
#
# Copy to .env and fill in real values. .env is gitignored and must NEVER be
# committed. This file contains PLACEHOLDERS ONLY — never put a real key here.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# WARNING: every variable prefixed VITE_ is embedded in the built JavaScript
# and is PUBLIC. Anyone can read it in the browser's devtools. It is NOT a
# secret, even though it lives in a .env file.
#
# Therefore: NEVER put a private API key, token, password or credential in a
# VITE_ variable. If a service requires a secret key, it cannot be called
# directly from the browser — it needs a backend or a serverless proxy.
# ---------------------------------------------------------------------------

# Public base URL for fetching mission datasets at runtime.
# Used if the official dataset is too large or licensing forbids committing it.
VITE_DATA_BASE_URL=https://example.com/data

# Optional public NASA API key. The documented public value is DEMO_KEY, which
# is heavily rate-limited. A personal key from https://api.nasa.gov is also
# public once bundled — see the warning above. Leave unset unless
# a live API is used.
VITE_NASA_API_KEY=DEMO_KEY

# Feature flags (true/false). Useful for hiding unfinished work.
VITE_ENABLE_DEBUG_OVERLAY=false
